# --- Dependencies ---
# This will ignore node_modules in both backend/ and frontend/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment Variables ---
# This ignores .env files in both backend/ and frontend/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Build & Output ---
# Ignores build folders in frontend and dist folders in backend
dist/
build/
out/

# --- IDE & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

